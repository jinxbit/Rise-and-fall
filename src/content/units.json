        "canCrossCliffs": false
      },
      "actions": [
        {
          "id": "create-nomad",
          "name": "Create Nomad",
          "description": "Create a Nomad on an adjacent hex. Cannot target a hex across a cliff edge.",
          "effect": {
            "actionType": "create",
            "targetUnit": "Nomad",
            "targetHex": { "location": "adj", "crossCliff": false },
            "cost": { "gold": 0, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "create-merchant",
