{
  "$schema": "./units.schema.json",
  "units": [
    {
      "id": "city",
      "name": "City",
      "description": "",
      "victoryPoints": { "byBoardCount": [] },
      "supply": { "byPlayerCount": { "2": 8, "3": 8, "4": 8 } },
      "movement": {
        "isMobile": false,
        "terrains": [],
        "canCrossCliffs": false
      },
      "actions": [
        {
          "id": "create-nomad",
          "name": "Create Nomad",
          "description": "Create a Nomad on an adjacent hex. Cannot target a hex across a cliff edge.",
          "effect": {
            "actionType": "create",
            "targetUnit": "nomad",
            "targetHex": { "location": "adj" },
            "cost": { "gold": 0, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "create-merchant",
          "name": "Create Merchant",
          "description": "Create a Merchant on an adjacent hex. Cannot target a hex across a cliff edge.",
          "effect": {
            "actionType": "create",
            "targetUnit": "merchant",
            "targetHex": { "location": "adj" },
            "cost": { "gold": 2, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "create-mountaineer",
          "name": "Create Mountaineer",
          "description": "Create a Mountaineer on an adjacent hex. Cannot target a hex across a cliff edge.",
          "effect": {
            "actionType": "create",
            "targetUnit": "mountaineer",
            "targetHex": { "location": "adj" },
            "cost": { "gold": 1, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "generate-income",
          "name": "Generate Income",
          "description": "Generate gold based on the terrain type the City occupies.",
          "effect": {
            "actionType": "income",
            "goldByTerrain": { "plain": 2, "forest": 3, "mountain": 1 }
          }
        }
      ]
    },
    {
      "id": "temple",
      "name": "Temple",
      "description": "",
      "victoryPoints": { "byBoardCount": [] },
      "supply": { "byPlayerCount": { "2": 3, "3": 3, "4": 3 } },
      "movement": {
        "isMobile": false,
        "terrains": [],
        "canCrossCliffs": false
      },
      "actions": [
        {
          "id": "convert-enemy-unit",
          "name": "Convert Enemy Unit",
          "description": "Convert an adjacent enemy unit to your control. Only mobile units can be converted.",
          "effect": {
            "actionType": "convert",
            "targetHex": { "location": "adj" },
            "targetOwner": "enemy",
            "targetMobileOnly": true,
            "cost": { "gold": 0, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "generate-income",
          "name": "Generate Income",
          "description": "Generate 2 gold for each adjacent unit you control that is not a Temple.",
          "effect": {
            "actionType": "income",
            "goldPerAdjacentOwnUnit": 2,
            "excludeUnitTypes": ["temple"]
          }
        }
      ]
    },
    {
      "id": "nomad",
      "name": "Nomad",
      "description": "",
      "victoryPoints": { "byBoardCount": [] },
      "supply": { "byPlayerCount": { "2": 8, "3": 8, "4": 8 } },
      "movement": {
        "isMobile": true,
        "terrains": ["plain", "forest", "mountain"],
        "canCrossCliffs": false,
        "moveDistance": 1,
        "blockedByUnits": "all"
      },
      "actions": [
        {
          "id": "produce-resource",
          "name": "Produce Resource",
          "description": "Produce a resource based on the terrain the Nomad occupies: 1 wood in Forest, 1 stone in Mountain.",
          "effect": {
            "actionType": "produce",
            "resourceByTerrain": {
              "forest": { "wood": 1 },
              "mountain": { "stone": 1 }
            }
          }
        },
        {
          "id": "transform-to-ship",
          "name": "Transform to Ship",
          "description": "Transform into a Ship on an adjacent water hex.",
          "effect": {
            "actionType": "transform",
            "targetUnit": "ship",
            "targetHex": { "terrainType": ["water"], "location": "adj" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 1, "stone": 0 }
          }
        },
        {
          "id": "transform-to-city",
          "name": "Transform to City",
          "description": "Transform into a City in its own space. Only on Plain or Forest.",
          "effect": {
            "actionType": "transform",
            "targetUnit": "city",
            "targetHex": { "terrainType": ["plain", "forest"], "location": "self" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 1, "stone": 1 }
          }
        },
        {
          "id": "transform-to-temple",
          "name": "Transform to Temple",
          "description": "Transform into a Temple in its own space. Only on Plain or Mountain.",
          "effect": {
            "actionType": "transform",
            "targetUnit": "temple",
            "targetHex": { "terrainType": ["plain", "mountain"], "location": "self" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 0, "stone": 2 }
          }
        }
      ]
    },
    {
      "id": "merchant",
      "name": "Merchant",
      "description": "",
      "victoryPoints": { "byBoardCount": [] },
      "supply": { "byPlayerCount": { "2": 6, "3": 6, "4": 6 } },
      "movement": {
        "isMobile": true,
        "terrains": ["water", "plain", "forest", "mountain"],
        "canCrossCliffs": false,
        "moveDistance": 4,
        "blockedByUnits": "none",
        "canEndMoveOnUnitTypes": ["city"]
      },
      "actions": [
        {
          "id": "buy-wood",
          "name": "Buy Wood",
          "description": "Buy 1 Wood for 5 gold.",
          "effect": {
            "actionType": "trade-resource",
            "resource": "wood",
            "mode": "buy",
            "resourceAmount": 1,
            "goldPerResource": 5
          }
        },
        {
          "id": "sell-wood",
          "name": "Sell Wood",
          "description": "Sell 1 Wood for 5 gold.",
          "effect": {
            "actionType": "trade-resource",
            "resource": "wood",
            "mode": "sell",
            "resourceAmount": 1,
            "goldPerResource": 5
          }
        },
        {
          "id": "buy-stone",
          "name": "Buy Stone",
          "description": "Buy 1 Stone for 5 gold.",
          "effect": {
            "actionType": "trade-resource",
            "resource": "stone",
            "mode": "buy",
            "resourceAmount": 1,
            "goldPerResource": 5
          }
        },
        {
          "id": "sell-stone",
          "name": "Sell Stone",
          "description": "Sell 1 Stone for 5 gold.",
          "effect": {
            "actionType": "trade-resource",
            "resource": "stone",
            "mode": "sell",
            "resourceAmount": 1,
            "goldPerResource": 5
          }
        },
        {
          "id": "generate-income",
          "name": "Generate Income",
          "description": "Generate gold based on adjacent Cities: 3 gold per adjacent own City, 5 gold per adjacent enemy City.",
          "effect": {
            "actionType": "income",
            "goldPerAdjacentUnit": {
              "own": { "city": 3 },
              "enemy": { "city": 5 }
            }
          }
        },
        {
          "id": "transform-to-ship",
          "name": "Transform to Ship",
          "description": "Transform into a Ship on an adjacent water hex.",
          "effect": {
            "actionType": "transform",
            "targetUnit": "ship",
            "targetHex": { "terrainType": ["water"], "location": "adj" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 2, "stone": 0 }
          }
        }
      ]
    },
    {
      "id": "mountaineer",
      "name": "Mountaineer",
      "description": "",
      "victoryPoints": { "byBoardCount": [] },
      "supply": { "byPlayerCount": { "2": 3, "3": 3, "4": 3 } },
      "movement": {
        "isMobile": true,
        "terrains": ["water", "plain", "forest", "mountain", "glacier"],
        "canCrossCliffs": true,
        "moveDistance": 3,
        "blockedByUnits": "enemy"
      },
      "actions": [
        {
          "id": "produce-resource",
          "name": "Produce Resource",
          "description": "Produce a resource based on the terrain the Mountaineer occupies: 1 wood in Forest, 1 stone in Mountain, 1 stone in Glacier.",
          "effect": {
            "actionType": "produce",
            "resourceByTerrain": {
              "forest": { "wood": 1 },
              "mountain": { "stone": 1 },
              "glacier": { "stone": 1 }
            }
          }
        },
        {
          "id": "transform-to-city",
          "name": "Transform to City",
          "description": "Transform into a City in its own space. Only on Forest or Mountain.",
          "effect": {
            "actionType": "transform",
            "targetUnit": "city",
            "targetHex": { "terrainType": ["forest", "mountain"], "location": "self" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 2, "stone": 0 }
          }
        }
      ]
    },
    {
      "id": "ship",
      "name": "Ship",
      "description": "",
      "victoryPoints": { "byBoardCount": [] },
      "supply": { "byPlayerCount": { "2": 5, "3": 5, "4": 5 } },
      "movement": {
        "isMobile": true,
        "terrains": ["water"],
        "canCrossCliffs": false,
        "moveDistance": "unlimited",
        "blockedByUnits": "none"
      },
      "actions": [
        {
          "id": "transform-to-nomad",
          "name": "Transform to Nomad",
          "description": "",
          "effect": {
            "actionType": "transform",
            "targetUnit": "nomad",
            "targetHex": { "terrainType": ["plain"], "location": "adj" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "transform-to-city",
          "name": "Transform to City",
          "description": "",
          "effect": {
            "actionType": "transform",
            "targetUnit": "city",
            "targetHex": { "terrainType": ["plain"], "location": "adj" },
            "destroySelf": true,
            "cost": { "gold": 0, "wood": 0, "stone": 1 }
          }
        },
        {
          "id": "transform-to-merchant",
          "name": "Transform to Merchant",
          "description": "",
          "effect": {
            "actionType": "transform",
            "targetUnit": "merchant",
            "targetHex": { "terrainType": ["plain"], "location": "adj" },
            "destroySelf": true,
            "cost": { "gold": 5, "wood": 0, "stone": 0 }
          }
        },
        {
          "id": "trade",
          "name": "Trade",
          "description": "",
          "effect": {
            "actionType": "trade",
            "goldPerCity": 5
          }
        }
      ]
    }
  ]
}
