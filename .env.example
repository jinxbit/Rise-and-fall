VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Testing only — shows a "Continue as guest" option on the home page so you
# can test without setting up Discord OAuth. Requires "Allow anonymous
# sign-ins" enabled in Supabase (Authentication → Sign In / Providers).
# Leave unset in production — Discord sign-in should be mandatory there.
VITE_ALLOW_GUEST_AUTH=true
