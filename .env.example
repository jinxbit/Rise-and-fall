VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Testing only — shows a "Continue as guest" option on the home page so you
# can test without setting up Discord OAuth. Requires "Allow anonymous
# sign-ins" enabled in Supabase (Authentication → Sign In / Providers).
# Leave unset in production — Discord sign-in should be mandatory there.
VITE_ALLOW_GUEST_AUTH=true

# Public half of a VAPID keypair, used to opt a browser into "your turn" Web
# Push notifications. Generate with `npx web-push generate-vapid-keys` — see
# README.md's "Push notifications" section for full backend setup. Leave
# unset to hide the notification opt-in (it needs the backend half deployed
# too, not just this key).
VITE_VAPID_PUBLIC_KEY=

# Names a NON-production environment, e.g. "Preview" or "Local". When set, the
# app shows a small badge naming this environment and the Supabase project it
# is talking to. A build is configured entirely at build time, so without this
# there is nothing on screen that tells pre-production apart from production —
# which has already caused real mistakes (DELIVERY_PIPELINE_PLAN.md §8).
# Leave it UNSET in production: no badge is the production state, so it cannot
# be got wrong by forgetting to configure something.
VITE_ENVIRONMENT=Local
